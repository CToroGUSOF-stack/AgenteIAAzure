# Development settings
AUTH_DISABLED=true

# Azure AD / Entra ID Authentication
AZURE_AD_CLIENT_ID=your_client_id
AZURE_AD_CLIENT_SECRET=your_client_secret
AZURE_AD_TENANT_ID=your_tenant_id
AZURE_AD_REDIRECT_URI=http://localhost:8000/api/auth/token
AZURE_AD_SCOPE=api://your-app-id/.default

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Azure AI Search Configuration
AZURE_SEARCH_ENDPOINT=https://your-service.search.windows.net
AZURE_SEARCH_KEY=your_admin_key
AZURE_SEARCH_INDEX=documents-index
AZURE_SEARCH_USERDOCS_INDEX=userdocs-index

# Indexing configuration (Azure AI Search - uso en /indexing)
# Rutas y parámetros para el procesamiento e indexación de documentos
DOCUMENTS_PATH= c:\Users\Path\To\Your\Documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
BATCH_SIZE=100

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_key

# Azure Storage Configuration
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_CONTAINER_USERFILES=user-files
USER_UPLOAD_MAX_BYTES=16777216

# Azure Cosmos DB Configuration
AZURE_COSMOS_DB_KEY=your_key
AZURE_COSMOS_DB_ENDPOINT=https://your-account.documents.azure.com:443/
AZURE_COSMOS_DATABASE_NAME=alimentario_db
AZURE_COSMOS_SESSION_CONTAINER_NAME=sessions
AZURE_COSMOS_MESSAGE_CONTAINER_NAME=messages

# Chatbot settings
MESSAGE_MEMORY_LIMIT=10
